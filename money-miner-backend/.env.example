# money-miner backend — copy to .env and fill in. NEVER commit .env.
# The real .env on the server holds actual values (chmod 600).

# Postgres DSN from the infra docker network (host alias "db").
MM_DATABASE_URL=postgres://money_miner:<password>@db:5432/money_miner?sslmode=disable
# Same DB reachable from the host loopback (local `go run` dev):
MM_DATABASE_URL_LOCAL=postgres://money_miner:<password>@127.0.0.1:5432/money_miner?sslmode=disable

# Public app URL (no trailing slash).
MM_PUBLIC_URL=https://money-miner.thecsdoctor.com

# Keycloak realm (issuer = public URL; JWKS fetched via the internal
# container address to avoid the hairpin on every token).
MM_OIDC_ISSUER=https://auth.thecsdoctor.com/realms/money-miner
MM_OIDC_JWKS_URL=http://keycloak:8080/realms/money-miner/protocol/openid-connect/certs

# SIMULATED demo engine gate (dossier 01/07 — API-flagged, UI-badged).
ALLOW_SIMULATED=false
# Seed a demo wallet+miner for the test user on boot (dev/demo only).
SEED_TEST_DATA=false

# Test user created in the realm by provisioning (login for smoke tests).
MM_TEST_USER=test@money-miner.local
MM_TEST_USER_PASSWORD=
MM_TEST_USER_SUB=

# Optional knobs (defaults shown):
# MM_LISTEN=127.0.0.1:8080
# MM_ALLOWED_ORIGINS=https://money-miner.thecsdoctor.com
# MM_PAYOUT_POLL_INTERVAL=10m
# MM_RETENTION_INTERVAL=1h
# MM_EXCHANGE_KEY_SALT=money-miner-v0.1
