# deploy/.env — copy from .env.example, chmod 600, NEVER commit.
# DB role password printed by create-database.sh at provisioning time
# (also embedded in money-miner-backend/.env's MM_DATABASE_URL).
MONEY_MINER_DB_PASSWORD=

# stamped into the server binary + /v1/healthz
MM_VERSION=0.1.0

# server runtime (see money-miner-backend/.env.example for the full list)
MM_PUBLIC_URL=https://money-miner.thecsdoctor.com
MM_OIDC_ISSUER=https://auth.thecsdoctor.com/realms/money-miner
MM_OIDC_JWKS_URL=http://keycloak:8080/realms/money-miner/protocol/openid-connect/certs
MM_ALLOWED_ORIGINS=https://money-miner.thecsdoctor.com
ALLOW_SIMULATED=true
SEED_TEST_DATA=true
MM_TEST_USER_SUB=
